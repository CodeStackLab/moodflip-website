# MoodFlip Environment Variables
# ================================
# Copy this file to .env.local and fill in your real values.
# IMPORTANT: Never commit .env.local to Git. Keep these keys secret.
#
# As per Business Specification §14 & §19:
# "The Stripe/payment account must be owned by Joy.
#  Payment API keys should be connected securely through environment variables.
#  No customer payments should go through DigitalWorkify's account."

# ── STRIPE PAYMENT (Joy must use HER OWN Stripe account) ──────────────────────
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY_HERE
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET_HERE

# ── SUPABASE DATABASE ──────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# ── CRON JOB SECURITY ─────────────────────────────────────────────────────────
# Used to secure /api/cron/cleanup route (90-day profile deletion)
# Generate a random secret: https://generate-secret.vercel.app/32
CRON_SECRET=YOUR_RANDOM_CRON_SECRET_HERE

# ── ADMIN PANEL ───────────────────────────────────────────────────────────────
ADMIN_EMAIL=joy@moodflip.coach
ADMIN_PASSWORD_HASH=YOUR_BCRYPT_HASHED_PASSWORD

# ── EMAIL DELIVERY (PDF delivery after payment) ───────────────────────────────
# For automatic PDF email delivery after Stripe payment (Spec §9)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@moodflip.coach
SMTP_PASS=YOUR_EMAIL_PASSWORD

# ── GEMINI AI (optional - for AI mood flip enhancement) ───────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── SITE CONFIG ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://moodflip.coach
