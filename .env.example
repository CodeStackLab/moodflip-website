# Supabase Environment Variables
# Copy this file to .env.local for local development
# And add these exact keys into your Vercel Project Settings > Environment Variables

NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
DATABASE_URL=postgresql://...

# Server-only security settings
ADMIN_PASSWORD=use-a-long-unique-password
CRON_SECRET=use-a-long-random-secret

# Stripe (owned by the MoodFlip owner)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Transactional email and contact delivery
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=MoodFlip <deliveries@moodflip.coach>
CONTACT_EMAIL=owner@example.com

# Privacy-friendly Google Analytics configuration
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_ADMIN_EMAIL=owner@example.com
